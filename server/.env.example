# SurfacesUI Server Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# LLM Provider Configuration (for generate_ui tool)
# Options: bedrock | anthropic | openai
LLM_PROVIDER=bedrock

# Bedrock Configuration (default)
AWS_REGION=us-east-1
# Note: Bedrock uses AWS SSO credentials by default
# Login with: aws sso login
# Or set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY

# Alternative: Anthropic Direct API
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Alternative: OpenAI API
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# Teradata Connection (for execute_sql tool)
TD_USER=your_username
TD_PASSWORD=your_password
TD_HOST=your-host.clearscape.teradata.com

# Optional: Alternative host variable name (some configs use this)
# TD_DEFAULT_HOST=your-host.clearscape.teradata.com

# Optional: Teradata logon mechanism (default: TD2)
# TD_LOGMECH=TD2

# Server Configuration
HTTP_PORT=3000
MOCK_MODE=false
HTTP_ONLY=false

# MCP Configuration (for vantage-mcp integration)
VANTAGE_MCP_MODE=stdio
VANTAGE_MCP_BINARY=/path/to/vantage-mcp/bin/vantage-mcp

# Optional: For HTTP mode instead of stdio
# VANTAGE_MCP_MODE=http
# VANTAGE_MCP_ADDR=http://localhost:8080

# Logging
LOG_LEVEL=info
