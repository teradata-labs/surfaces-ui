{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notes.mjs guard", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notes.mjs loaded", "timeout": 10 }]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notes.mjs loaded", "timeout": 10 }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notes.mjs reset", "timeout": 10 }]
      }
    ]
  }
}
