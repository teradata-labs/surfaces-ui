{
  "name": "surfaces-ui",
  "version": "0.1.0",
  "private": true,
  "description": "SurfacesUI Components - Reusable React components served via MCP Apps protocol",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter @surfacesui/components build && pnpm --filter @surfacesui/app-framework build && pnpm --filter @surfacesui/mcp-adapter build && pnpm --filter @surfacesui/server build",
    "build:apps": "pnpm --filter @surfacesui/components build:apps",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "register:loom": "pnpm --filter @surfacesui/components register:loom",
    "unregister:loom": "pnpm --filter @surfacesui/components unregister:loom"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1005.0",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.3.1",
    "openai": "^6.25.0",
    "prettier": "^3.7.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@modelcontextprotocol/ext-apps",
      "@swc/core"
    ]
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
