{
  "name": "@surfaces-ui/agent",
  "version": "0.0.0",
  "description": "AgentBackend interface, event helpers and stream adapters for Surfaces UI chat",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@surfaces-ui/data": "workspace:*",
    "@surfaces-ui/proto": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
