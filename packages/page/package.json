{
  "name": "@surfaces-ui/page",
  "version": "0.1.0",
  "description": "Surfaces UI pages as one script and one stylesheet, for plain HTML pages with no build step",
  "keywords": [
    "surfaces-ui",
    "analytics",
    "data"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teradata-labs/surfaces-ui.git",
    "directory": "packages/page"
  },
  "homepage": "https://github.com/teradata-labs/surfaces-ui#readme",
  "bugs": {
    "url": "https://github.com/teradata-labs/surfaces-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./surfaces-page.js": "./dist/surfaces-page.js",
    "./surfaces-page.css": "./dist/surfaces-page.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && node check-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@surfaces-ui/components": "workspace:*",
    "@surfaces-ui/data": "workspace:*",
    "@surfaces-ui/spec": "workspace:*",
    "@surfaces-ui/tokens": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
