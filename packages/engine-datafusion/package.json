{
  "name": "@surfaces-ui/engine-datafusion",
  "version": "0.0.0",
  "description": "DataFusion engine adapter for Surfaces UI: talks to a DataFusion server over HTTP and reads Arrow",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@surfaces-ui/engine": "workspace:*",
    "@surfaces-ui/proto": "workspace:*",
    "@surfaces-ui/sql": "workspace:*",
    "apache-arrow": "^21.2.0"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
