{
  "name": "@surfaces-ui/engine",
  "version": "0.1.0",
  "description": "Engine adapter interface for Surfaces UI servers",
  "keywords": [
    "surfaces-ui",
    "analytics",
    "data"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teradata-labs/surfaces-ui.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/teradata-labs/surfaces-ui#readme",
  "bugs": {
    "url": "https://github.com/teradata-labs/surfaces-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
