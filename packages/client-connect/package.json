{
  "name": "@surfaces-ui/client-connect",
  "version": "0.0.0",
  "description": "Connect client that implements DataSource",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
