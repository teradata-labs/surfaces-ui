{
  "name": "@surfaces-ui/spec",
  "version": "0.2.0",
  "description": "Component catalog, A2UI surface model and React renderer for agent-generated UI",
  "keywords": [
    "surfaces-ui",
    "analytics",
    "data",
    "a2ui",
    "generative-ui",
    "agent",
    "catalog",
    "react"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teradata-labs/surfaces-ui.git",
    "directory": "packages/spec"
  },
  "homepage": "https://github.com/teradata-labs/surfaces-ui#readme",
  "bugs": {
    "url": "https://github.com/teradata-labs/surfaces-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@surfaces-ui/components": "workspace:*",
    "@surfaces-ui/data": "workspace:*",
    "@surfaces-ui/proto": "workspace:*",
    "@surfaces-ui/tokens": "workspace:*",
    "@surfaces-ui/trace": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@surfaces-ui/discovery": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
