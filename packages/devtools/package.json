{
  "name": "@surfaces-ui/devtools",
  "version": "0.1.0",
  "description": "Developer tools for Surfaces UI: one component that records and shows the messages, components, problems, state, events, agent turns and service calls of agent-generated UI, with time travel",
  "keywords": [
    "surfaces-ui",
    "analytics",
    "data",
    "devtools",
    "react",
    "tracing"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teradata-labs/surfaces-ui.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://github.com/teradata-labs/surfaces-ui#readme",
  "bugs": {
    "url": "https://github.com/teradata-labs/surfaces-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./panel": {
      "types": "./dist/Panel.d.ts",
      "default": "./dist/Panel.js"
    },
    "./app-components": {
      "types": "./dist/appComponents.d.ts",
      "default": "./dist/appComponents.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@surfaces-ui/components": "workspace:*",
    "@surfaces-ui/data": "workspace:*",
    "@surfaces-ui/spec": "workspace:*",
    "@surfaces-ui/trace": "workspace:*"
  },
  "devDependencies": {
    "@surfaces-ui/agent": "workspace:*",
    "@surfaces-ui/chat": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
