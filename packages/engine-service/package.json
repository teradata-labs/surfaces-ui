{
  "name": "@surfaces-ui/engine-service",
  "version": "0.0.0",
  "description": "QueryService, CatalogService and SourceService over engine adapters, in Node or a browser",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teradata-labs/surfaces-ui.git",
    "directory": "packages/engine-service"
  },
  "homepage": "https://github.com/teradata-labs/surfaces-ui#readme",
  "bugs": {
    "url": "https://github.com/teradata-labs/surfaces-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
