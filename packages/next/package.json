{
  "name": "@surfaces-ui/next",
  "version": "0.3.0",
  "description": "Serve Surfaces UI pages from a Next.js app: routes, metadata and server-rendered pages, with Next.js doing the routing, building and hosting",
  "keywords": [
    "surfaces-ui",
    "nextjs",
    "next",
    "site",
    "ssr",
    "static-export"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teradata-labs/surfaces-ui.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/teradata-labs/surfaces-ui#readme",
  "bugs": {
    "url": "https://github.com/teradata-labs/surfaces-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@surfaces-ui/components": "workspace:*",
    "@surfaces-ui/spec": "workspace:*",
    "@surfaces-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@surfaces-ui/data": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
