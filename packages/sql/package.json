{
  "name": "@surfaces-ui/sql",
  "version": "0.4.0",
  "description": "Dialect-aware SQL rewriting for sort, filter and paging",
  "keywords": [
    "surfaces-ui",
    "analytics",
    "data",
    "sql",
    "dialect",
    "teradata",
    "duckdb"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teradata-labs/surfaces-ui.git",
    "directory": "packages/sql"
  },
  "homepage": "https://github.com/teradata-labs/surfaces-ui#readme",
  "bugs": {
    "url": "https://github.com/teradata-labs/surfaces-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@polyglot-sql/sdk": "^0.14.1",
    "@surfaces-ui/data": "workspace:*",
    "@surfaces-ui/proto": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
