{
  "name": "@surfaces-ui/pipelines",
  "version": "0.0.0",
  "description": "Reference pipeline runner for Surfaces UI: builds datasets from one another on an Engine, with data quality rules",
  "keywords": [
    "surfaces-ui",
    "analytics",
    "data",
    "pipelines",
    "data-quality"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teradata-labs/surfaces-ui.git",
    "directory": "packages/pipelines"
  },
  "homepage": "https://github.com/teradata-labs/surfaces-ui#readme",
  "bugs": {
    "url": "https://github.com/teradata-labs/surfaces-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@surfaces-ui/data": "workspace:*",
    "@surfaces-ui/engine": "workspace:*",
    "@surfaces-ui/proto": "workspace:*",
    "@surfaces-ui/sql": "workspace:*"
  },
  "devDependencies": {
    "@surfaces-ui/engine-duckdb": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
