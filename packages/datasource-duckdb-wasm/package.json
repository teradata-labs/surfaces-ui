    "@surfaces-ui/sql": "workspace:*",
    "apache-arrow": "^21.2.0"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@surfaces-ui/seeds": "workspace:*",
    "@types/node": "^26.6.6",
    "@surfaces-ui/engine-duckdb": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
