{
  "name": "@surfaces-ui/datasource-duckdb-wasm",
  "version": "0.4.0",
  "description": "A DataSource that runs DuckDB in the browser (WebAssembly): real SQL over Parquet with no server",
  "keywords": [
    "surfaces-ui",
    "analytics",
    "data",
    "duckdb",
    "wasm",
    "browser"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teradata-labs/surfaces-ui.git",
    "directory": "packages/datasource-duckdb-wasm"
  },
  "homepage": "https://github.com/teradata-labs/surfaces-ui#readme",
  "bugs": {
    "url": "https://github.com/teradata-labs/surfaces-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
