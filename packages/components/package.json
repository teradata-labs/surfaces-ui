{
  "name": "@surfacesui/components",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme/tokens.css": "./src/theme/tokens.css",
    "./tailwind-preset": "./src/theme/tailwind-preset.ts"
  },
  "files": [
    "dist",
    "src/theme/tokens.css",
    "src/theme/tailwind-preset.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:apps": "rm -rf dist/apps && APP=sql-editor-cdn vite build --config vite.config.apps.ts && APP=json-render-cdn vite build --config vite.config.apps.ts && npm run build:apps:move",
    "build:apps:move": "test -d dist/apps/src/apps && mv dist/apps/src/apps/*.html dist/apps/ && rm -rf dist/apps/src || true",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "figma-tokens": "tsx scripts/figma-tokens-cli.ts",
    "generate-covalent-theme": "tsx scripts/generate-covalent-theme.ts",
    "check-theme-a11y": "tsx scripts/check-theme-accessibility.ts",
    "register:loom": "node scripts/register-loom-apps.mjs",
    "unregister:loom": "node scripts/register-loom-apps.mjs --unregister"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.13",
    "@json-render/core": "^0.15.0",
    "@json-render/react": "^0.15.0",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@uiw/react-codemirror": "^4.25.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.575.0",
    "prismjs": "^1.30.0",
    "react-simple-code-editor": "^0.14.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.10.0",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^4.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-singlefile": "2.3.2",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
