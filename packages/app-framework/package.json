{
  "name": "@surfacesui/app-framework",
  "version": "0.1.0",
  "description": "One-liner bootstrap and build preset for MCP App HTML bundles",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@tailwindcss/vite": "^4.2.1",
    "vite-plugin-singlefile": "^2.3.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^28.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.0.0",
    "vite": "^8.0.2",
    "vitest": "^4.0.18",
    "@surfacesui/components": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@surfacesui/components": "workspace:*",
    "vite": "^6.0.0 || ^7.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
