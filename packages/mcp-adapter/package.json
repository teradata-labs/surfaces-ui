{
  "name": "@surfacesui/mcp-adapter",
  "version": "0.1.0",
  "description": "Framework-agnostic MCP resource/tool adapter for surfaces-ui HTML apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "apps"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @surfacesui/components build:apps && node scripts/copy-apps.js",
    "build": "tsc",
    "clean": "rimraf dist apps",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^6.0.2",
    "rimraf": "^6.0.1",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
